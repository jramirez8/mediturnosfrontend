import React, { useState } from "react";
import { KeyboardAvoidingView, Platform, ScrollView, StyleSheet, Text, View } from "react-native";
import BrandMark from "../components/BrandMark";
import MedButton from "../components/MedButton";
import MedInput from "../components/MedInput";

/**
 * Login corregido:
 * - No usa banner/cartulina del logo.
 * - Campos glass lavanda, no full blancos.
 * - Sin íconos raros de usuario/password.
 * - Password con ojito abierto/cerrado.
 * - Altura recortada: termina apenas debajo de Crear cuenta.
 * - Mismo tamaño de fuente en Ingresar / Biometría / Crear cuenta.
 */
export default function LoginScreenFixed() {
  const [identifier, setIdentifier] = useState("41147663");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);

  return (
    <KeyboardAvoidingView behavior={Platform.OS === "ios" ? "padding" : undefined} style={styles.root}>
      <ScrollView
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.backgroundCircleOne} />
        <View style={styles.backgroundCircleTwo} />

        <View style={styles.brandRow}>
          <BrandMark size={42} />
          <Text style={styles.brandText}>Mediturnos</Text>
        </View>

        <Text style={styles.title}>Iniciar sesión</Text>
        <Text style={styles.subtitle}>Bienvenido de nuevo</Text>

        <View style={styles.form}>
          <MedInput
            label="Email o DNI"
            value={identifier}
            onChangeText={setIdentifier}
            keyboardType="default"
            placeholder="Email o DNI"
          />

          <MedInput
            label="Contraseña"
            value={password}
            onChangeText={setPassword}
            placeholder="Contraseña"
            secureTextEntry={!showPassword}
            secureVisible={showPassword}
            onToggleSecure={() => setShowPassword((v) => !v)}
          />

          <Text style={styles.forgot}>¿Olvidaste tu contraseña?</Text>
          <Text style={styles.safeText}>Ingreso seguro activado para {identifier || "tu cuenta"}.</Text>

          <MedButton title="Ingresar" arrow />
          <MedButton title="Ingresar con biometría / PIN" variant="secondary" />
          <MedButton title="Crear cuenta" variant="secondary" />
        </View>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

const styles = StyleSheet.create({
  root: {
    flex: 1,
    backgroundColor: "#FBF9FF",
  },
  content: {
    minHeight: "100%",
    paddingHorizontal: 28,
    paddingTop: 58,
    paddingBottom: 28,
    overflow: "hidden",
  },
  backgroundCircleOne: {
    position: "absolute",
    top: -120,
    right: -160,
    width: 420,
    height: 420,
    borderRadius: 210,
    backgroundColor: "rgba(126,58,242,0.08)",
  },
  backgroundCircleTwo: {
    position: "absolute",
    top: 210,
    left: -170,
    width: 360,
    height: 360,
    borderRadius: 180,
    backgroundColor: "rgba(199,180,255,0.14)",
  },
  brandRow: {
    alignSelf: "center",
    flexDirection: "row",
    alignItems: "center",
    gap: 12,
    marginBottom: 44,
    paddingHorizontal: 18,
    paddingVertical: 10,
    borderRadius: 999,
    backgroundColor: "rgba(255,255,255,0.38)",
    borderWidth: 1,
    borderColor: "rgba(126,58,242,0.10)",
  },
  brandText: {
    color: "#7E3AF2",
    fontSize: 17,
    fontWeight: "800",
    letterSpacing: 0.5,
  },
  title: {
    color: "#251044",
    fontSize: 46,
    lineHeight: 52,
    fontWeight: "800",
    letterSpacing: -1.8,
    marginBottom: 18,
  },
  subtitle: {
    color: "#817990",
    fontSize: 24,
    fontWeight: "600",
    marginBottom: 52,
  },
  form: {
    gap: 0,
  },
  forgot: {
    color: "#5F2EB3",
    fontSize: 18,
    fontWeight: "800",
    textAlign: "right",
    marginTop: 0,
    marginBottom: 28,
  },
  safeText: {
    color: "#817990",
    fontSize: 15,
    fontWeight: "700",
    marginBottom: 22,
  },
});
