{
  "expo": {
    "name": "Mediturnos",
    "slug": "mediturnos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/mediturnos-square-logo.png",
    "scheme": "mediturnos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mediturnos-square-logo.png",
      "bundleIdentifier": "com.mediturnos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/mediturnos-square-logo-transparent.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mediturnos.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/mediturnos-square-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EEFF",
          "android": {
            "image": "./assets/images/mediturnos-square-logo-transparent.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mediturnos usa Face ID para iniciar sesión de forma segura."
        }
      ],
      "expo-image-picker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9632dfff-9b58-47e1-82d1-8acee0772d0f"
      }
    },
    "owner": "jramirez8"
  }
}
